# === Core ===
PARIKSHIT_ENV=development
PARIKSHIT_DATA_DIR=./data
PARIKSHIT_DB_URL=sqlite:///./data/parikshit.db
PORT=8000
HOST=0.0.0.0

# === LLM Gateway ===
LLM_PROVIDER=mock # watsonx | openai | anthropic | huggingface | mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# === IBM watsonx.ai (When LLM_PROVIDER=watsonx) ===
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_VERSION=2024-05-31
WATSONX_DEFAULT_MODEL=ibm/granite-3-8b-instruct
WATSONX_EMBEDDING_MODEL=ibm/slate-30m-english-rtrvr
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_BUILDER_MODEL=gpt-4o
LLM_ADVERSARY_MODEL=gpt-4o
LLM_REVIEWER_MODEL=gpt-4o-mini
LLM_MAX_TOKENS_PER_SESSION=100000
LLM_DAILY_BUDGET_USD=20.00

# === Sandbox ===
SANDBOX_ENABLED=false
SANDBOX_IMAGE=parikshit-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_TIMEOUT_SEC=120
SANDBOX_NETWORK=none

# === Security / Limits ===
MAX_REPO_SIZE_MB=200
MAX_FILE_COUNT=3000
MAX_FILE_SIZE_MB=5
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
PARIKSHIT_LOCAL_SOURCE_ROOTS=./data/demo,data/demo
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === Frontend ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SSE_URL=http://localhost:8000/api/v1

# === Optional Auth ===
AUTH_DISABLED=true
PARIKSHIT_API_KEY=
